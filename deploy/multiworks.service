[Unit]
Description=MultiWorks private workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=multiworks
Group=multiworks
WorkingDirectory=/opt/multiworks
EnvironmentFile=/opt/multiworks/.env
ExecStart=/usr/bin/node /opt/multiworks/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/multiworks
UMask=0077

[Install]
WantedBy=multi-user.target
